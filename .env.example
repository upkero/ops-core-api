# Copy this file to .env and adjust the values for your environment.

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: POSTGRES                                                  |
# +--------------------------------------------------------------------------+
# Consumed by the "db" service in docker-compose.yml, which refuses to start
# without POSTGRES_PASSWORD. The value below is a placeholder, not a password:
# set your own before exposing the database beyond your machine, and keep it in
# step with the one inside DB_URL if you run the API outside compose (compose
# builds DB_URL for the container itself). Use letters and digits, or
# URL-encode the password inside DB_URL.
# Postgres reads the password only when it first creates the data volume, so
# changing it later means `docker compose down -v` (this deletes the data) or
# ALTER USER inside the running database.
POSTGRES_DB="ops_core"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-db-password"

# +--------------------------------------------------------------------------+
# | APPLICATION: DATABASE SETTINGS                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings.
# Inside docker compose use service name "db"; outside use "localhost".
DB_URL="postgresql+asyncpg://postgres:change-me-db-password@db:5432/ops_core"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING SETTINGS                                             |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings.
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# Log format: json (production) | text (local development)
LOG_FORMAT="json"

# +--------------------------------------------------------------------------+
# | APPLICATION: EMBEDDING SETTINGS                                           |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.embeddings.EmbeddingSettings.
# Provider profile:
#   hashing            - deterministic local embeddings, no API key, works offline (default)
#   openai             - the OpenAI embeddings API, requires EMBEDDING_API_KEY
#   openai_compatible  - any OpenAI-compatible server, requires EMBEDDING_BASE_URL
#   local              - sentence-transformers in this process, e.g.
#                          EMBEDDING_MODEL="BAAI/bge-m3"  EMBEDDING_DIMENSIONS=1024
#                        also set LOCAL_MODELS=true here (image build arg) and rebuild;
#                        weights download on first start into the hf_cache volume.
#
# Changing the provider or the model invalidates everything already indexed:
# vectors from two models are not comparable, and comparing them returns
# plausible scores rather than an error. Each chunk records the model that
# produced it, so search refuses to mix them and tells you to re-index with
#   python -m src.app.cli.seed --force
EMBEDDING_PROVIDER="hashing"
EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_API_KEY="your_api_key"
# Inside docker compose use a service name; outside use "localhost".
# EMBEDDING_BASE_URL="http://ollama:11434/v1"

# Must match the vector(N) column width in the database schema.
# Changing it requires a new Alembic migration.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | APPLICATION: API KEY                                                      |
# +--------------------------------------------------------------------------+
# Required. Guards every endpoint under /api/v1 via the X-API-Key request
# header. Only /health/live, /health/ready and the schema endpoints answer
# without it.
# The value below is a placeholder, not a key. The four agent services that
# call this API ship the same literal in their own .env.example, so copying
# every .env.example to .env gives a demo where all five agree. Generate a real
# one before deploying anywhere public — and rotate it in all five at once:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY="change-me-min-16-chars"


# +--------------------------------------------------------------------------+
# | APPLICATION: RATE LIMITING                                                |
# +--------------------------------------------------------------------------+
# Requests per minute per client IP, counted per route template (/bookings/{id}
# is one route whatever the id). In-memory, so
# the counters are per process (the container runs a single uvicorn worker).
RATE_LIMIT_PER_MINUTE=60

# Tighter limit for POST /documents and POST /documents/search, which call the
# embedding provider and therefore cost more than the other endpoints.
EMBEDDING_RATE_LIMIT_PER_MINUTE=20

# +--------------------------------------------------------------------------+
# | APPLICATION: BOOKING SLOTS                                                |
# +--------------------------------------------------------------------------+
# Demo slots are topped up on every start so that the next SLOT_WINDOW_DAYS days
# (from tomorrow) always have slots. slot_date/slot_time carry no zone: they are
# the wall clock of the business, in BUSINESS_TIMEZONE (an IANA name).
SLOT_WINDOW_DAYS=14
BUSINESS_TIMEZONE="Europe/Moscow"

# +--------------------------------------------------------------------------+
# | APPLICATION: CORS                                                         |
# +--------------------------------------------------------------------------+
# Comma-separated list of allowed browser origins. Empty (the default in code)
# means no browser client may call the API; the values below are for local
# development. Replace them with the real portfolio domain before deploying.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
