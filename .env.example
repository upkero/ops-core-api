# Copy this file to .env and adjust the values for your environment.

# +--------------------------------------------------------------------------+
# | INFRASTRUCTURE: POSTGRES                                                  |
# +--------------------------------------------------------------------------+
# Consumed by the "db" service in docker-compose.yml.
POSTGRES_DB="ops_core"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# +--------------------------------------------------------------------------+
# | APPLICATION: DATABASE SETTINGS                                            |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.app.AppSettings.
# Inside docker compose use service name "db"; outside use "localhost".
DB_URL="postgresql+asyncpg://postgres:postgres@db:5432/ops_core"

# +--------------------------------------------------------------------------+
# | APPLICATION: LOGGING SETTINGS                                             |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.logging.LoggingSettings.
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# Log format: json (production) | text (local development)
LOG_FORMAT="json"

# +--------------------------------------------------------------------------+
# | APPLICATION: EMBEDDING SETTINGS                                           |
# +--------------------------------------------------------------------------+
# Settings from src.app.core.settings.embeddings.EmbeddingSettings.
# Provider profile:
#   hashing            - deterministic local embeddings, no API key, works offline (default)
#   openai             - the OpenAI embeddings API, requires EMBEDDING_API_KEY
#   openai_compatible  - any OpenAI-compatible server, requires EMBEDDING_BASE_URL
EMBEDDING_PROVIDER="hashing"
EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_API_KEY="your_api_key"
# Inside docker compose use a service name; outside use "localhost".
# EMBEDDING_BASE_URL="http://ollama:11434/v1"

# Must match the vector(N) column width in the database schema.
# Changing it requires a new Alembic migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | APPLICATION: CORS                                                         |
# +--------------------------------------------------------------------------+
# Comma-separated list of allowed browser origins.
# Replace with the real portfolio domain before deploying.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
